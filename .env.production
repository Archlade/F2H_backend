# F2H — production configuration for api.f2hmarket.com
#
# Read INSTEAD of .env, because the server's systemd unit sets:
#
#   Environment=F2H_ENV_FILE=/srv/webapps/farmapp/.env.production
#
# That separation is the point. `.env` is committed and holds development
# settings, so every `git pull` used to overwrite the server's config with a
# laptop's — wrong database user, a macOS path for the Firebase key, localhost
# CORS. Keeping the two files apart means a deploy is `git pull` and nothing
# else.
#
# ── Before this file works, fill in the two lines marked TODO ────────────────

FLASK_ENV=production
FLASK_DEBUG=False

# Freshly generated, and different from the pair in .env — those were published
# in this repository's public history and must never sign a production token.
# ProductionConfig refuses to start if either looks like a placeholder, so if
# the service boots, these are real.
SECRET_KEY=ZKfxYZcysZichZp4xR7Tw7NsDSs1Bi8DV3sUKF-nt_UWkYDsv8A8tANJCKbI_hll
JWT_SECRET_KEY=6YwPcUhWqHjS0YuRJ_tRAyS0v_Genkn3zC5QpSxb8hyjkMwdMCXYlsUcZC8KSbTt

# ── Database ─────────────────────────────────────────────────────────────────
# NOT root. MySQL on Ubuntu authenticates root over the unix socket, so a
# password login fails with error 1698 — which is exactly how the API went down
# the last time this file came from a Mac.
DB_HOST=localhost
DB_PORT=3306
DB_USER=f2h
DB_PASSWORD=TODO_the_password_you_gave_the_f2h_mysql_user
DB_NAME=f2h_db

# ── Admin seed ───────────────────────────────────────────────────────────────
# Used once, when seeding the first admin. Must not match DB_PASSWORD — reusing
# one credential means one leak costs you both.
ADMIN_EMAIL=jovelrobin07@gmail.com
ADMIN_PASSWORD=TODO_a_different_password_from_the_database_one

# Weekly baskets are sold by F2H, not by a farm, so one admin account acts as
# the seller on every basket delivery. Its name is what customers see. Defaults
# to ADMIN_EMAIL above if unset; basket generation stops with an explanatory
# error rather than picking an arbitrary admin.
PLATFORM_SELLER_EMAIL=jovelrobin07@gmail.com

# ── Web front end ────────────────────────────────────────────────────────────
# Browser-only. The mobile app sends a bearer token and never uses CORS.
CORS_ORIGINS=https://f2hmarket.com,https://www.f2hmarket.com
FRONTEND_URL=https://f2hmarket.com

# The site is on f2hmarket.com and this API is on api.f2hmarket.com, so the auth
# cookies have to belong to the parent domain both share. Without the leading
# dot they are host-only to api.f2hmarket.com, the page cannot read the CSRF
# token, and every authenticated write fails while browsing still works.
JWT_COOKIE_DOMAIN=.f2hmarket.com

# ── Email ────────────────────────────────────────────────────────────────────
# Blank means password reset is off: links are written to the server log instead
# of sent, which is why "Forgot password" is hidden in the app
# (AppConfig.passwordResetEnabled). Fill these in and flip that flag to restore
# self-service recovery — until then a locked-out user needs you to intervene.
#
# MAIL_PASSWORD is a Google App Password, not the account password:
# Google Account → Security → 2-Step Verification → App passwords.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# The scheme the app registers for "open in the app" links in reset emails.
MOBILE_APP_SCHEME=f2h

# ── Uploads ──────────────────────────────────────────────────────────────────
# Relative to the process working directory. nginx must allow at least this
# much too — `client_max_body_size 12M;` — or a photo is rejected with a 413
# before Flask ever sees it.
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH_MB=10

# ── Socket.IO ────────────────────────────────────────────────────────────────
# gunicorn must run an eventlet worker to match. The app's socket client is
# websocket-only with no polling fallback, so nginx also has to upgrade
# /socket.io/ or chat and live order updates fail silently.
SOCKETIO_ASYNC_MODE=eventlet

# ── Push notifications ───────────────────────────────────────────────────────
# Absolute, and a path that exists on this machine. push_service checks
# os.path.exists() against the process working directory, which under systemd is
# not the project folder — a relative path here reads as "not configured" and
# every notification is dropped in silence.
FIREBASE_CREDENTIALS=/srv/webapps/farmapp/secrets/firebase-service-account.json

# ── Money ────────────────────────────────────────────────────────────────────
# Snapshotted onto each payment when an order is confirmed, so changing the rate
# never rewrites what a farmer was owed on a past order.
PLATFORM_COMMISSION_RATE=20
MIN_PAYOUT_AMOUNT=200

# ── Scheduled work ───────────────────────────────────────────────────────────
# Shared secret for POST /api/cron/run, called by the VPS crontab once a day to
# send weekly-basket reminders and generate due deliveries. Nothing else in the
# system runs on a schedule, so if this is unset those two things never happen
# on their own. Rotate it like any other credential.
CRON_TOKEN=k_jrs_wzzB-KHBfAs3q8C_qWRvEBtf_MXXCiHh3Vd3xJw14y
