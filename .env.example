# TEMPLATE ONLY — this file is committed to git.
#
# NEVER put real credentials here. Copy it to .env, which is ignored,
# and fill that in instead. A real password once lived in this file and
# was published to a public repository as a result.

FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=f2h_db

# Admin seed account (used ONLY for initial seeding)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=choose-a-strong-one

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# File uploads
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH_MB=10

# Socket.IO
SOCKETIO_ASYNC_MODE=eventlet

# Push notifications (Firebase Cloud Messaging)
#
# Path to the service-account key: Firebase Console -> Project settings ->
# Service accounts -> Generate new private key. NOT the app's
# google-services.json. Leave blank and push is simply off; everything else
# works unchanged.
FIREBASE_CREDENTIALS=secrets/firebase-service-account.json
