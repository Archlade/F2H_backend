FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=f2h-dev-secret-key-2024-change-in-production
JWT_SECRET_KEY=f2h-jwt-secret-key-2024-change-in-production

# Database — update these with your MySQL credentials
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=9255jom1JO!
DB_NAME=f2h_db

# Admin seed account
ADMIN_EMAIL=jovelrobin07@gmail.com
ADMIN_PASSWORD=9255jom1JO!

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Where password-reset links point (defaults to the first CORS origin)
FRONTEND_URL=http://localhost:5173

# ── Email (password reset) ────────────────────────────────────────────────────
# Preconfigured for Gmail. Fill in the two blank lines below and reset emails
# start sending immediately — no code changes needed.
#
#   MAIL_USERNAME  your full Gmail address, e.g. you@gmail.com
#   MAIL_PASSWORD  a Google App Password — NOT your normal account password.
#
# To get an App Password: Google Account → Security → 2-Step Verification must
# be on → App passwords → generate one for "Mail". It looks like "abcd efgh ijkl
# mnop"; paste it with or without the spaces.
#
# Until both are filled in, reset links are printed to the Flask console
# instead of being emailed, so the flow stays testable.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
# Leave blank for Gmail. Gmail refuses to send as an address you don't own, so
# the sender falls back to "F2H <your MAIL_USERNAME>" automatically. Only set
# this if you run your own mail server.
MAIL_DEFAULT_SENDER=

# The custom scheme the mobile app registers, used for the "open in the app"
# link in reset emails. Change only if you also change it in the app.
MOBILE_APP_SCHEME=f2h

# File uploads
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH_MB=10

# Socket.IO
SOCKETIO_ASYNC_MODE=eventlet

# Push notifications (Firebase Cloud Messaging).
# Absolute path: push_service checks os.path.exists() against the process
# working directory, which under gunicorn/systemd is usually not this folder,
# so a relative path silently reads as "not configured".
# On the VPS this becomes the server path, e.g.
#   /home/youruser/F2H/backend/secrets/firebase-service-account.json
FIREBASE_CREDENTIALS=/Users/jovelrobin/Desktop/F2H/backend/secrets/firebase-service-account.json
